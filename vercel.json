{
  "builds": [
    {
      "src": "django-quiz-app-main/src/quizsite/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.9"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "django-quiz-app-main/src/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "django-quiz-app-main/src/quizsite/wsgi.py"
    }
  ]
}
